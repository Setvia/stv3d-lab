{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 21,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "mingw",
            "displayName": "MinGW + vcpkg (x64-mingw-dynamic)",
            "description": "g++ 13 + vcpkg cpr, Win32 window + OpenGL 4.3, output goes to build/",
            "generator": "MinGW Makefiles",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "D:/MinGW/bin/g++.exe",
                "CMAKE_TOOLCHAIN_FILE": "D:/git/repos/vcpkg/scripts/buildsystems/vcpkg.cmake",
                "VCPKG_TARGET_TRIPLET": "x64-mingw-dynamic",
                "CMAKE_BUILD_TYPE": "Debug"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "mingw",
            "configurePreset": "mingw"
        }
    ]
}

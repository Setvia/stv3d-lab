<!DOCTYPE RCC>
<RCC version="1.0">
    <!-- Shaders stay real files on disk (so the editor gives them GLSL highlighting) and are
         embedded into the executable at build time. -->
    <qresource prefix="/">
        <file>shaders/basic.vert</file>
        <file>shaders/basic.frag</file>
    </qresource>
</RCC>
